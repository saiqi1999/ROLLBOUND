{
  "name": "rollbound",
  "main": "web/src/server/playtest-worker.ts",
  "compatibility_date": "2026-04-15",
  "workers_dev": true,
  "preview_urls": false,
  "vars": {
    "PLAYTEST_ORIGIN": "https://saiqi1999.github.io"
  },
  "kv_namespaces": [
    {
      "binding": "PLAYTEST_RUNS"
    }
  ],
  "durable_objects": {
    "bindings": [{ "name": "PLAYTEST_ARCHIVE", "class_name": "PlaytestArchive" }]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["PlaytestArchive"] }
  ],
  "ratelimits": [
    {
      "name": "PLAYTEST_LIMITER",
      "namespace_id": "646074201",
      "simple": {
        "limit": 12,
        "period": 60
      }
    }
  ]
}
